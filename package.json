{
  "name": "@rafamacalaba/armada",
  "version": "1.2.3",
  "description": "Turn any repo into a self-organizing AI engineering team — one command, 8 specialists, evidence-gated delivery. For opencode.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafmacalaba/armada.git"
  },
  "bugs": {
    "url": "https://github.com/rafmacalaba/armada/issues"
  },
  "homepage": "https://github.com/rafmacalaba/armada#readme",
  "bin": {
    "armada": "./src/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "starter/**",
    "template",
    "agents",
    "presets",
    "docs/RELEASING.md",
    "docs/WHY.md",
    "docs/auth-and-cost.md",
    "docs/contributor-guide.md",
    "docs/getting-started.md",
    "docs/logo.png",
    "docs/operator-guide.md",
    "docs/support.md",
    "docs/troubleshooting.md",
    "docs/user-guide.md",
    "docs/workflow.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "dev": "node src/cli.js",
    "test": "node --test --test-concurrency=4 tests/*.test.js",
    "test:smoke": "node --test 'tests/smoke/*.test.js'",
    "test:node": "node --test 'tests/*.test.js'",
    "test:packed": "node tests/run-packed-test.js",
    "prepublishOnly": "node --test 'tests/*.test.js'"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "opencode",
    "agents",
    "orchestrator",
    "multi-agent",
    "ai-engineer",
    "cli",
    "code-generation",
    "automation",
    "devtools",
    "scaffolding",
    "evidence-gated",
    "ai-coding"
  ],
  "license": "MIT",
  "peerDependencies": {
    "opencode": "^1.18.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependenciesMeta": {
    "opencode": {
      "optional": true
    }
  }
}
