{
  "name": "opencode-armada",
  "version": "0.9.2",
  "description": "Turn any repo into a self-organizing AI engineering team — one command, 8 specialists, evidence-gated delivery. For opencode.",
  "type": "module",
  "bin": {
    "armada": "./src/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "template",
    "starter",
    "agents",
    "presets",
    "docs"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "dev": "node src/cli.js",
    "test": "node --test 'tests/*.test.js'",
    "test:smoke": "node --test 'tests/smoke/*.test.js'",
    "test:node": "node --test 'tests/*.test.js'",
    "prepublishOnly": "node --test 'tests/*.test.js'"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "opencode",
    "agents",
    "orchestrator",
    "multi-agent",
    "ai-engineer",
    "cli",
    "code-generation",
    "automation",
    "devtools",
    "scaffolding",
    "evidence-gated",
    "ai-coding"
  ],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
